# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
certificates

# Claude AI files
.claude/

# Log files and text dumps (may contain sensitive data like bearer tokens)
*.log
*.txt
!CLAUDE.md
!*.md
# ...except the ones under public/, which are SERVED TO THE INTERNET by definition and so
# cannot be holding anything secret. robots.txt only escapes the rule above because it was
# tracked before the rule existed; llms.txt had no such luck and was silently unstageable.
!public/*.txt
# Generated at build time from the running ap2service, never committed: one source of truth for
# the MCP server card, so the published copy cannot drift from the one sent to the registry.
public/.well-known/mcp.json
