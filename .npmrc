# @headlessui/react@1.x declares `peer react@"^16 || ^17 || ^18"` and this project is on
# React 19, so a strict resolve fails on EVERY install. It has always needed
# --legacy-peer-deps; this puts that where npm reads it automatically instead of relying on
# each caller remembering, which is a thing callers do not do:
#
#   - the CI build passes the flag explicitly and works
#   - cloudflare/wrangler-action runs its own `npm i wrangler` and cannot be told to, so the
#     Pages deploy failed with ERESOLVE after a perfectly good build
#   - a plain `npm install` fails locally for the same reason
#
# The real fix is @headlessui/react@2, which supports React 19 — a contained but non-trivial
# migration across seven files (Transition and Dialog both changed API). Until then this makes
# the flag a property of the repo rather than of whoever happens to be typing.
legacy-peer-deps=true
