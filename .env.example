# Client-side configuration
# Set to 'null' for local development to remove /webapp prefix from routes
NEXT_PUBLIC_BASE_PATH=null
COOKIE_DOMAIN=localhost

# Content Security Policy - Frame Ancestors Configuration
# Controls which domains can embed the webapp in iframes
# Options:
# - Leave empty/unset: Use default allowed domains (Farcaster, self)
# - Specific domains: "https://merchant1.com https://merchant2.com"
# - Wildcard patterns: "https://*.wordpress.com https://*.shopify.com"
# - '*' to allow all domains (use with caution in production)
# ALLOWED_FRAME_ANCESTORS=https://*.wordpress.com https://*.shopify.com

# Server-side only (runtime)
# Chain ID for your EVM network (8453 for Base Mainnet, 84532 for Base Sepolia)
# Must match the chainId used in SUPPORTED_TOKENS below.
CHAIN_ID=8453
# RPC URL for your chosen network
RPC_URL=https://base.llamarpc.com

# Token Configuration (NEW - Centralized)
# JSON array of supported tokens with enhanced metadata
# When SUPPORTED_TOKENS is provided, individual token env vars are optional (legacy fallback)
SUPPORTED_TOKENS=[{"symbol":"USDC","address":"0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913","name":"USD Coin","decimals":6,"isDefault":true,"icon":"/tokens/usdc.svg","color":"#2775CA","enabled":true,"chainId":8453},{"symbol":"USDT","address":"0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2","name":"Tether USD","decimals":6,"isDefault":false,"icon":"/tokens/usdt.svg","color":"#26A17B","enabled":true,"chainId":8453},{"symbol":"DAI","address":"0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb","name":"Dai Stablecoin","decimals":18,"isDefault":false,"icon":"/tokens/dai.svg","color":"#F4B731","enabled":true,"chainId":8453}]

# Legacy Token Configuration (Optional - Fallback when SUPPORTED_TOKENS not provided)
# USDC contract address on your chosen network (Base mainnet)
USDC_CONTRACT_ADDRESS=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
# USDT contract address on your chosen network (Base mainnet)
USDT_CONTRACT_ADDRESS=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2
# Default token symbol to use (e.g., USDC, USDT, DAI)
DEFAULT_TOKEN_SYMBOL=USDC
# Block explorer base URL for your chosen network (used to build transaction links)
EXPLORER_BASE_URL=https://base.blockscout.com
# Contract addresses are NOT configured here - the webapp fetches them from
# chainservice at GET /api/chain/addresses (see pages/api/config.ts). Set
# CHAIN_SERVICE_URL below instead; config loading fails if it is unreachable.
MOONPAY_API_KEY=your_moonpay_api_key_here
# WalletConnect/Reown project ID from https://dashboard.reown.com (exposed to frontend)
# Required for wallet connection - add http://localhost:3000 to the project's allowed
# origins in the Reown dashboard for local development
WALLETCONNECT_PROJECT_ID=7569c63c696a4e8aeb3217c1b1332bd7
# Onramp Money AppId for Nigerian Naira (NGN) fiat on-ramp
ONRAMP_APP_ID=1953324
# Coinbase Onramp (CDP) - used as the default fiat on-ramp for non-NGN users
# Project ID from https://portal.cdp.coinbase.com (UUID, exposed to frontend)
COINBASE_PROJECT_ID=37c83e48-6b76-4104-a5b5-469b83500c43
# CDP API key ID (UUID from the downloaded JSON `id` field) - server-side only
COINBASE_API_KEY_ID=your-api-key-uuid
# CDP API key secret (base64-encoded Ed25519 key from the downloaded JSON `privateKey` field) - server-side only
COINBASE_API_KEY_SECRET=your_base64_ed25519_secret_here
# Exchange Rate API URL for currency conversion (optional, defaults to Coinbase)
# NEXT_PUBLIC_EXCHANGE_RATE_API_URL=https://api.coinbase.com/v2/exchange-rates
USER_SERVICE_URL=http://localhost:8977
CHAIN_SERVICE_URL=http://localhost:8978
# Projects (fan-out / completion escrow) services
FANOUT_SERVICE_URL=http://localhost:8083
FANOUT_CHAIN_SERVICE_URL=http://localhost:8979
CONTRACT_SERVICE_URL=http://localhost:8080
X_API_KEY=your_chain_service_api_key_here

# Gas Configuration
# Minimum gas price in wei
MIN_GAS_WEI=5
# Reject transactions priced above this gas price (gwei)
MAX_GAS_PRICE_GWEI=0.03
# Reject transactions whose total gas cost exceeds this (gwei)
MAX_GAS_COST_GWEI=14800
# Multiplier applied to the network-suggested gas price
GAS_PRICE_BUFFER=1.2
# Multiplier applied to the foundry gas estimates below
GAS_MULTIPLIER=1.1
# Foundry-measured gas limits per operation
USDC_GRANT_FOUNDRY_GAS=65000
RAISE_DISPUTE_FOUNDRY_GAS=8200
DEPOSIT_FUNDS_FOUNDRY_GAS=86500
CLAIM_FUNDS_FOUNDRY_GAS=40800

SERVICE_LINK=http://localhost:3000
PRODUCT_NAME=Conduit UCPI
NEYNAR_API_KEY=your_neynar_api_key_here
NEYNAR_API_URL=https://api.neynar.com/v2/farcaster

# Advertising Tracking
# Reddit Pixel ID (get from Reddit Ads Manager: https://ads.reddit.com)
NEXT_PUBLIC_REDDIT_PIXEL_ID=your_reddit_pixel_id_here

# API Validation
# Runtime validation of API responses against their schemas.
# Set to 'false' to disable; any other value (or unset) leaves it enabled.
API_VALIDATION_ENABLED=true
# Whether a schema mismatch should fail the request rather than just log
API_VALIDATION_FAIL_ON_MISMATCH=false
API_VALIDATION_TIMEOUT=30000
API_VALIDATION_ENVIRONMENT=development

# Shopify App Configuration
# Credentials from your app in the Shopify Partner dashboard
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here
SHOPIFY_NAME=buyer-protected-usdc-checkout
SHOPIFY_SCOPES=write_orders,write_draft_orders,write_products,read_customers
# Random string used to sign session cookies - generate a fresh one per environment
SESSION_SECRET=your_random_session_secret_here_change_in_production
